
<div class="icon-gallery">

<% chars.each do |char| %>

  <div class="icon-gallery-item">

      <div class="log-icon-container">
          <a href="/char/<%= char[:name] %>">
             <% if char[:avatar] %>
              <img class="log-icon" src="/game/uploads/<%= char[:avatar]['icon'] %>" alt="<%= char[:name] %>'s icon" />
             <% else %>
             <img class="log-icon" src="/game/uploads/theme_images/noicon.png" alt="<%= char[:name] %>'s icon"  />
             <% end %>
          </a>
      </div>

      <div class="log-icon-title-container">
          <div class="log-icon-title">
           <%= char[:name] %>
          </div>
      </div>

    </div>
              
<% end %>

</div>


<div class="clearfix"> 
</div>
